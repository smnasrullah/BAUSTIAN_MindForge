# Copied to .env by run.bat / run.sh on first start. Never commit .env.

# --- Database (DATABASE_URL is built from these in docker-compose.yml) ---
POSTGRES_USER=agentpulse
POSTGRES_PASSWORD=agentpulse
POSTGRES_DB=agentpulse

# --- Host ports ---
FRONTEND_PORT=5173
BACKEND_PORT=8000

# --- App ---
SEED=42
# Clock: live = data and predictions follow the real time in Asia/Dhaka (hourly tick, catch-up
# on start); fixed = frozen at 2026-04-30 20:00 Dhaka (reproducible benchmark). Switching
# rebuilds the synthetic data on the next start.
CLOCK_MODE=live
# Placeholder only: run.bat / run.sh replace it with a random 64-hex value when creating .env.
# The backend refuses to start if JWT_SECRET is under 32 bytes.
JWT_SECRET=__GENERATED_ON_FIRST_RUN__
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
# Set true only when the app is served over HTTPS.
REFRESH_COOKIE_SECURE=false
# Optional risk cut-offs per horizon: P(stockout) for [amber, red]. Unset = defaults in
# backend/app/rules/risk_rules.py. Example: RISK_THRESHOLDS={"6": [0.1, 0.3], "24": [0.2, 0.5]}
# RISK_THRESHOLDS=
# ML method switches (docs/DECISIONS.md, ML upgrade; all results on synthetic data).
# Serve the validation-calibrated (conformal) q10-q90 forecast band.
FORECAST_CONFORMAL=true
# Stockout DECISION input (no refill): independent = each float alone (default, higher recall at
# the risk cuts above); joint = both floats from joint paths with the estimated copula.
STOCKOUT_METHOD=independent
# Rebalance + swap rules (backend/app/rules). Recommendation = shortfall at q90 + buffer;
# deadline = stockout time - lead time. Swaps: donor within radius, minimum amount.
REBALANCE_HORIZON_H=24
REBALANCE_LEAD_TIME_H=3
REBALANCE_BUFFER_SHARE=0.10
REBALANCE_BUFFER_MIN_BDT=2000
SWAP_RADIUS_KM=5
SWAP_MIN_AMOUNT_BDT=5000
# Delivery channel (backend/app/rules/channel_rules.py); assumptions in docs/METHODS.md.
VAN_MIN_BATCH_AMOUNT_BDT=100000
VAN_LEAD_TIME_H=4
VAN_CLUSTER_RADIUS_KM=10
VAN_COST_PER_TRIP_BDT=1500
TOPUP_FEE_PCT=0.5
TOPUP_ETA_H=0.25
SELF_FETCH_MAX_KM=10
SELF_FETCH_SPEED_KMH=15
TRAVEL_COST_PER_KM_BDT=10
URGENT_MANUAL_COST_BDT=2500
# Van route optimizer (backend/app/rules/van_routing; synthetic assumptions in
# docs/SYNTHETIC_ASSUMPTIONS.md section 9). Fixed cost per van that leaves = VAN_COST_PER_TRIP_BDT.
# VAN_COUNT must be at least 2.
VAN_COUNT=2
VAN_CAPACITY_BDT=1500000
VAN_CASH_CAP_BDT=1500000
VAN_SHIFT_H=8
VAN_COST_PER_KM_BDT=25
VAN_COST_PER_HOUR_BDT=200
VAN_MINUTES_PER_STOP=10
VAN_SPEED_KMH=25
VAN_ROAD_FACTOR=1.35
VAN_HORIZON_H=24
VAN_TIME_LIMIT_S=10
VAN_SOLUTION_LIMIT=300
VAN_EID_TIME_FACTOR=1.5
VAN_RAIN_TIME_FACTOR=1.3
VAN_RAIN_MM=20
VAN_HAT_BAZAR_TIME_FACTOR=1.2
# Van V3: stockout limit (deadline + before-arrival flag), fairness bounds per area, near-optimal
# pick share, ETA range factors on driving time, freeze window (docs/SYNTHETIC_ASSUMPTIONS.md 9).
VAN_STOCKOUT_P_LIMIT=0.3
VAN_FAIR_MAX_WAIT_H=8
VAN_FAIR_MIN_SERVICE_RATE=0.5
VAN_NEAR_OPTIMAL_PCT=0.03
VAN_ETA_LO_FACTOR=0.85
VAN_ETA_HI_FACTOR=1.3
VAN_FREEZE_MIN=30
# Impact backtest (backend/app/rules/impact_rules.py; assumptions in docs/METHODS.md).
# Baseline alerts when a float < share x capacity; AI plans at these local hours.
IMPACT_ALERT_SHARE=0.20
IMPACT_DECISION_HOURS=[8, 14, 20]
IMPACT_CASHOUT_FEE_PCT=1.85

# --- Liquidity help requests (advisory: nothing moves money) ---
# Defaults only: admins change them at runtime on /admin/help-settings (stored in the database).
# kill switch: false blocks new requests and new claims
HELP_ENABLED=true
# true: everything is recorded, nobody is notified
HELP_DRY_RUN=false
# a claimed request reopens if not confirmed in time
HELP_CLAIM_TIMEOUT_MIN=20
# per agent, across both floats
HELP_COOLDOWN_MIN=30
# rolling 24 h, cancelled requests count
HELP_DAILY_CAP_PER_AGENT=3
# agents per wave; the distributor is always asked as well
HELP_MAX_RECIPIENTS_PER_WAVE=5
# an expired request whose claim had timed out can still be confirmed late for this many hours
HELP_LATE_CONFIRM_GRACE_H=24
# Automatic trigger (backend/app/rules/help_trigger_rules.py; method in docs/METHODS.md).
# scheduler tick (sweep + waves + trigger); 0 turns it off
HELP_TRIGGER_INTERVAL_S=60
# look this many hours ahead on the cautious forecast path
HELP_TRIGGER_HORIZON_H=6
# safety buffer: % of the agent's expected 24 h drain
HELP_TRIGGER_BUFFER_PCT=25
# ignore smaller gaps below the buffer
HELP_TRIGGER_MIN_SHORTFALL_BDT=5000
# cap on one request (shortfall to zero + buffer)
HELP_TRIGGER_MAX_REQUEST_BDT=200000
# needed_by = forecast stock-out minus this
HELP_TRIGGER_LEAD_MARGIN_H=1
# needed_by is never sooner than this
HELP_TRIGGER_DEADLINE_FLOOR_MIN=15
# stock-out < 2 x floor: wave 1 asks this many x more agents
HELP_TRIGGER_URGENT_WAVE_MULTIPLIER=2
# helpers must be this close (same distributor)
HELP_TRIGGER_RADIUS_KM=5
# next wave when the current one has waited this long
HELP_TRIGGER_WAVE_TIMEOUT_MIN=15
# then the request expires and is escalated
HELP_TRIGGER_MAX_WAVES=3
# a helper asked this recently is skipped (fairness)
HELP_TRIGGER_RECENT_ASK_H=2
# at most this many new requests per scheduler tick, most urgent first; the rest wait
HELP_TRIGGER_MAX_NEW_PER_TICK=3
# Helper acceptance model (learned from SIMULATED behaviour only): order the helpers the rules
# allow by chance of a yes (learned) or by the rule score (rules, default); optional wave sizing
# asks the fewest helpers whose chance of at least one yes reaches the target (never above the
# rule's wave size).
HELP_RANK_MODEL=rules
HELP_WAVE_SIZING=false
HELP_WAVE_TARGET=0.9
# DEMO_MODE only: after a fresh bootstrap (new database) the first tick waits this many
# seconds; a plain restart does not wait
HELP_SCHEDULER_DEMO_START_DELAY_S=120
# DEMO_MODE only: demo defaults for the wave story (1 helper per wave, 2-minute waves, 3 waves,
# largest request 100000, no recent-ask window). Admin settings still win. false = env defaults.
HELP_DEMO_DEFAULTS=true
# DEMO_MODE only: automatic requests per agent and float per rolling 24 h (0 = no extra limit)
HELP_DEMO_AUTO_PER_DAY=1

# --- Demo logins (synthetic accounts, seeded on bootstrap) ---
# admin@agentpulse.demo | dist.dhaka@ / dist.chattogram@ / dist.sylhet@agentpulse.demo
# agent.mirpur@ / agent.patiya@ / agent.sunamganj@agentpulse.demo
# Help-request demo helpers near AGT-0001 (agent password, created after the data load):
# agent.mirpur11@ / agent.mirpur.sarkar@ / agent.mirpur.chowdhury@ / agent.mohammadpur@agentpulse.demo
DEMO_ADMIN_PASSWORD=admin-demo-2026
DEMO_DISTRIBUTOR_PASSWORD=distributor-demo-2026
DEMO_AGENT_PASSWORD=agent-demo-2026
# true: landing role cards sign in with one click (POST /auth/demo-login, is_demo accounts only,
# rate-limited, audited). Keep true for local / judge runs.
# PUBLIC HOSTING: set DEMO_MODE=false (the endpoint is then not registered at all).
DEMO_MODE=true
DEMO_LOGIN_PER_MIN=10

# --- Sign-up and password reset ---
# Self-signup creates pending agent accounts; an admin approves them on /admin/users.
SIGNUP_PER_HOUR=5
RESET_REQUEST_PER_HOUR=5
RESET_PER_ACCOUNT_PER_HOUR=3
RESET_TOKEN_TTL_MIN=30
# dev_log = DEVELOPMENT ONLY: reset links are written to the backend log, no email is sent.
MAILER=dev_log
# Origin users open the app at; reset links point here.
PUBLIC_BASE_URL=http://localhost:5173

# --- HTTP hardening ---
# Browser origins allowed to call the API cross-site, as a JSON list. Empty = same-origin only
# (nginx serves the app and /api together, so no CORS is needed).
CORS_ORIGINS=[]
# Per client IP: all /api requests, and POST /auth/login attempts (any email), per minute.
API_RATE_PER_MIN=1200
LOGIN_RATE_PER_MIN=60
# Largest accepted request body in bytes (nginx also caps bodies at 1 MB).
MAX_BODY_BYTES=1048576

# --- LLM (optional; app works without a key via replay/template) ---
# auto | anthropic | openai_compatible | replay | template
LLM_PROVIDER=auto
LLM_MODEL=claude-haiku-4-5-20251001
# Only for openai_compatible (Gemini / Groq / Ollama), e.g. http://host.docker.internal:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_S=8
# Live provider calls per UTC day (all users), then template text; per-user calls per minute.
LLM_DAILY_CALL_CAP=500
LLM_USER_CALLS_PER_MIN=10
